# Control plane the agent talks to (marketplace API). Default: https://api.doodleiq.com
DOODLEIQ_CONTROL_PLANE_URL=http://127.0.0.1:8081

# Only if your local model runtime requires a bearer token. Ollama and LM Studio
# do not. Picked up by `doodleiq configure` (or pass --api-key).
DOODLEIQ_MODEL_API_KEY=

# Override the machine labels shown on your marketplace listing. Handy on a
# rented/containerized box where the hostname is a random hash, the hardware
# isn't in DMI, and the timezone is UTC.
DOODLEIQ_MACHINE_NAME=
DOODLEIQ_MACHINE_MODEL=
DOODLEIQ_MACHINE_LOCATION=
